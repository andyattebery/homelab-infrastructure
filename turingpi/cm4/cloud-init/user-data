#cloud-config
# First-boot settings for every Raspberry Pi CM4 in this homelab (turingpi/cm4/README.md), on
# Canonical's Ubuntu Server for Raspberry Pi.
#
# turingpi/cm4/scripts/seed-image.sh writes this file into the image's system-boot partition as
# user-data, replacing Ubuntu's, next to the node's meta-data (turingpi/cm4/cloud-init/<hostname>/).
# cloud-init applies both on the first boot, then disables itself (the last write_files entry).
#
# Access is the Jetson's (turingpi/jetson/cloud-init/user-data.tpl): user services, uid 1000,
# passwordless sudo that keeps SSH_AUTH_SOCK, SSH keys only, no password. The keys are copied from
# nix/modules/ssh-keys.nix. A key changed there must be changed here too. users has no "default"
# entry, so Ubuntu's ubuntu user isn't created.

users:
  - name: services
    uid: 1000
    groups: [sudo, video, render]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINbbqGPcNfykhW1otDDfnW5NspRaHJYbpVVu+ZpobYtb"
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDjcevFbdJJVYgNRDzkU8qDlamNFm2/qcXEYAW2HmNqa"
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILzB/Pe+lol11t3Fwit7haMr7QsSpG4y/mAokuvZPXsu"
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFM8kpGI/ndVzIGhlOG8vcFzKky9SenwP9+7cvZcsA88"
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ4o8GVZBMulmiIVoqt5OJ2n5tlU4bx1+Mlnfkz974x/"
ssh_pwauth: false

timezone: America/Chicago
locale: en_US.UTF-8
manage_etc_hosts: localhost

write_files:
  - path: /etc/sudoers.d/91-ssh-auth-sock
    permissions: "0440"
    content: |
      Defaults env_keep += "SSH_AUTH_SOCK"
  # cloud-init runs once. Left enabled, it reads system-boot on every boot: edits there would do
  # nothing unless instance-id changed, and deleting the files would make it treat the node as new
  # and regenerate the SSH host keys. Re-provisioning is reflashing.
  - path: /etc/cloud/cloud-init.disabled
    defer: true
    content: ""

# Brings the network up on the first boot. netplan-configure.service picks the network backend
# early in boot, before cloud-init has written the netplan config from network-config, so on the
# first boot nothing starts systemd-networkd and the node stays off the network until a reboot
# (canonical/cloud-init #3084 and #5638). netplan apply starts it. runcmd runs in cloud-init's
# final stage, after multi-user.target.
runcmd:
  - [netplan, apply]
