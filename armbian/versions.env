# Pins for the RK1 image. Sourced by scripts/build-image.sh on the Mac, and copied into the
# build's userpatches/overlay/ so customize-image.sh can source it inside the image chroot.
# Every download is SHA-256 checked; a mismatch or a 404 fails the build. Bump a pin by
# changing its URL and hash together.

# Armbian build framework: main, pinned (rkr7.2 6.1.172, U-Boot SCMI fix #10543, bootscript fix #10617).
ARMBIAN_BUILD_REPO=https://github.com/armbian/build
ARMBIAN_BUILD_SHA=8eb7e43e11072fd5ad94cd9fafb859d96c573455

# armbian/linux-rockchip rk-6.1-rkr7.2. userpatches/config-rk1.conf repeats it in its kernel-pin
# hook; build-image.sh refuses to run if the two differ.
KERNEL_COMMIT=44bbd021d7808cab93d1f2d64c1f092038257576

# Mali G610 userspace, DDK g29p1 to match the kernel's kbase. ginkage deletes superseded
# releases (v1.10-1-db9112f went on 2026-10-01), so a 404 here means re-pin to the current one.
# 19834408 bytes.
LIBMALI_URL=https://github.com/ginkage/libmali-rockchip/releases/download/v1.10-1-e96672b/libmali-valhall-g610-g29p1_1.10-1_arm64.deb
LIBMALI_SHA256=67cf35d879f42f0190f749c50864daff6f105f2db9be8338ea5423475175b263

# RKNN runtime 2.3.2 (7726232 bytes) and RKLLM runtime 1.3.1 (7674816 bytes).
RKNNRT_URL=https://raw.githubusercontent.com/airockchip/rknn-toolkit2/v2.3.2/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so
RKNNRT_SHA256=d31fc19c85b85f6091b2bd0f6af9d962d5264a4e410bfb536402ec92bac738e8
RKLLMRT_URL=https://raw.githubusercontent.com/airockchip/rknn-llm/release-v1.3.1/rkllm-runtime/Linux/librkllm_api/aarch64/librkllmrt.so
RKLLMRT_SHA256=f25e9b099db08aaacd0a3ac62b4697d3951d6ae61ae41ea09f6702cfa89eb32c

# RKNN Toolkit Lite2 2.3.2. Its last wheel is cp312, so the image gets CPython 3.12 from uv.
RKNN_LITE_WHEEL_URL=https://files.pythonhosted.org/packages/ff/db/64c756f3f06b219e92ff4f0fd4e000870ee49f214d505ff01c8b0275e26d/rknn_toolkit_lite2-2.3.2-cp312-cp312-manylinux_2_17_aarch64.manylinux2014_aarch64.whl
RKNN_LITE_WHEEL_SHA256=e1e4ec691fed900c0e6fde5e7d8eeba17f806aa45092b63b361ee775e2c1b50e
UV_URL=https://github.com/astral-sh/uv/releases/download/0.12.21/uv-aarch64-unknown-linux-gnu.tar.gz
UV_SHA256=030b69227b40af8c1981b7301793dc66e71ed3c796ea8688209dd268bd91ec51

# Video: only jellyfin-ffmpeg8 may come from repo.jellyfin.org (userpatches/overlay/jellyfin.pref).
# apt checks the package against the signed index; for 8.1.3-1-trixie arm64 the deb's sha256 is
# 4af743bd776eda082d40c851a4201e51a77a258145dd6ebe164dade39b35b2d0.
JELLYFIN_KEY_URL=https://repo.jellyfin.org/jellyfin_team.gpg.key
JELLYFIN_KEY_SHA256=a0cde241ae297fa6f0265c0bf15ce9eb9ee97c008904a59ab367a67d59532839
JELLYFIN_FFMPEG_VERSION=8.1.3-1-trixie
