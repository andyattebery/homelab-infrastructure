{
  "name": "AV1 NVENC — Main (h264, <3000px, <50fps)",
  "description": "H.264 to AV1 (NVENC p7/uhq/10-bit CQ 34) in MP4. Width <3000 and fps <50 gates. Detects and replaces hardlinks. Three-stage integrity guard before source replacement. Preserves original file dates.",
  "tags": "video,av1,nvenc,hardlink",
  "flowPlugins": [
    {
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "id": "input1",
      "inputsDB": {},
      "position": { "x": 0, "y": 0 }
    },
    {
      "name": "Check Video Codec",
      "sourceRepo": "Community",
      "pluginName": "checkVideoCodec",
      "version": "1.0.0",
      "id": "checkCodec1",
      "inputsDB": { "codec": "h264" },
      "position": { "x": 300, "y": 0 }
    },
    {
      "name": "Check Width + FPS",
      "sourceRepo": "Local",
      "pluginName": "checkVideoProperties",
      "version": "1.0.0",
      "id": "checkProps1",
      "inputsDB": { "minWidth": "0", "maxWidth": "3000", "maxFps": "50" },
      "position": { "x": 600, "y": 0 }
    },
    {
      "name": "Detect Hardlinks",
      "sourceRepo": "Local",
      "pluginName": "detectHardlinks",
      "version": "1.0.0",
      "id": "detectHL1",
      "inputsDB": {},
      "position": { "x": 900, "y": 0 }
    },
    {
      "name": "Begin Command",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "id": "ffStart1",
      "inputsDB": {},
      "position": { "x": 1200, "y": 0 }
    },
    {
      "name": "Set Container",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetContainer",
      "version": "1.0.0",
      "id": "ffContainer1",
      "inputsDB": { "container": "mp4", "forceConform": "true" },
      "position": { "x": 1500, "y": 0 }
    },
    {
      "name": "Set Video Encoder",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetVideoEncoder",
      "version": "1.0.0",
      "id": "ffEncoder1",
      "inputsDB": {
        "outputCodec": "av1",
        "hardwareEncoding": "true",
        "hardwareType": "nvenc",
        "hardwareDecoding": "true",
        "forceEncoding": "false",
        "ffmpegPresetEnabled": "false",
        "ffmpegQualityEnabled": "false"
      },
      "position": { "x": 1800, "y": 0 }
    },
    {
      "name": "Remove Subtitles",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandRemoveSubtitles",
      "version": "1.0.0",
      "id": "ffRemoveSubs",
      "inputsDB": {},
      "position": { "x": 1900, "y": 0 }
    },
    {
      "name": "Remove Data Streams",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandRemoveDataStreams",
      "version": "1.0.0",
      "id": "ffRemoveData",
      "inputsDB": {},
      "position": { "x": 2000, "y": 0 }
    },
    {
      "name": "Check Audio Codec",
      "sourceRepo": "Community",
      "pluginName": "checkAudioCodec",
      "version": "1.0.0",
      "id": "checkAudio1",
      "inputsDB": { "codec": "aac" },
      "position": { "x": 2100, "y": 0 }
    },
    {
      "name": "Args (copy AAC)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "ffCustomCopy",
      "inputsDB": {
        "outputArguments": "-preset p7 -tune uhq -rc vbr -b:v 0 -cq 34 -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -b_ref_mode middle -g 120 -pix_fmt p010le -c:a copy"
      },
      "position": { "x": 2400, "y": -100 }
    },
    {
      "name": "Args (encode AAC)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "ffCustomEncode",
      "inputsDB": {
        "outputArguments": "-preset p7 -tune uhq -rc vbr -b:v 0 -cq 34 -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -b_ref_mode middle -g 120 -pix_fmt p010le -c:a aac"
      },
      "position": { "x": 2400, "y": 100 }
    },
    {
      "name": "Execute",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandExecute",
      "version": "1.0.0",
      "id": "ffExec1",
      "inputsDB": {},
      "position": { "x": 2700, "y": 0 }
    },
    {
      "name": "Check Duration Ratio",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "id": "checkDuration1",
      "inputsDB": {},
      "position": { "x": 3000, "y": 0 }
    },
    {
      "name": "Check Size Ratio",
      "sourceRepo": "Community",
      "pluginName": "compareFileSizeRatio",
      "version": "2.0.0",
      "id": "checkSize1",
      "inputsDB": { "greaterThan": "10" },
      "position": { "x": 3300, "y": 0 }
    },
    {
      "name": "Health Check",
      "sourceRepo": "Community",
      "pluginName": "runHealthCheck",
      "version": "1.0.0",
      "id": "healthCheck1",
      "inputsDB": { "checkType": "thorough" },
      "position": { "x": 3600, "y": 0 }
    },
    {
      "name": "Replace Original File",
      "sourceRepo": "Community",
      "pluginName": "replaceOriginalFile",
      "version": "1.0.0",
      "id": "replace1",
      "inputsDB": {},
      "position": { "x": 3900, "y": 0 }
    },
    {
      "name": "Keep Original Date",
      "sourceRepo": "Local",
      "pluginName": "keepOriginalDate",
      "version": "1.0.0",
      "id": "keepDate1",
      "inputsDB": {},
      "position": { "x": 4050, "y": 0 }
    },
    {
      "name": "Replace Hardlinks",
      "sourceRepo": "Local",
      "pluginName": "replaceHardlinks",
      "version": "1.0.0",
      "id": "replaceHL1",
      "inputsDB": {},
      "position": { "x": 4350, "y": 0 }
    },
    {
      "name": "Fail (Bad Duration)",
      "sourceRepo": "Community",
      "pluginName": "failFlow",
      "version": "1.0.0",
      "id": "failDuration",
      "inputsDB": {},
      "position": { "x": 3300, "y": -200 }
    },
    {
      "name": "Fail (Bad Size)",
      "sourceRepo": "Community",
      "pluginName": "failFlow",
      "version": "1.0.0",
      "id": "failSize",
      "inputsDB": {},
      "position": { "x": 3600, "y": -200 }
    }
  ],
  "flowEdges": [
    { "source": "input1",         "sourceHandle": "1", "target": "checkCodec1",    "targetHandle": null, "id": "e1" },
    { "source": "checkCodec1",    "sourceHandle": "1", "target": "checkProps1",    "targetHandle": null, "id": "e2" },
    { "source": "checkProps1",    "sourceHandle": "1", "target": "detectHL1",      "targetHandle": null, "id": "e3" },
    { "source": "detectHL1",      "sourceHandle": "1", "target": "ffStart1",       "targetHandle": null, "id": "e4" },
    { "source": "detectHL1",      "sourceHandle": "2", "target": "ffStart1",       "targetHandle": null, "id": "e5" },
    { "source": "ffStart1",       "sourceHandle": "1", "target": "ffContainer1",   "targetHandle": null, "id": "e6" },
    { "source": "ffContainer1",   "sourceHandle": "1", "target": "ffEncoder1",     "targetHandle": null, "id": "e7" },
    { "source": "ffEncoder1",     "sourceHandle": "1", "target": "ffRemoveSubs",   "targetHandle": null, "id": "e8a" },
    { "source": "ffRemoveSubs",   "sourceHandle": "1", "target": "ffRemoveData",   "targetHandle": null, "id": "e8b" },
    { "source": "ffRemoveData",   "sourceHandle": "1", "target": "checkAudio1",    "targetHandle": null, "id": "e8c" },
    { "source": "checkAudio1",    "sourceHandle": "1", "target": "ffCustomCopy",   "targetHandle": null, "id": "e9a" },
    { "source": "checkAudio1",    "sourceHandle": "2", "target": "ffCustomEncode", "targetHandle": null, "id": "e9b" },
    { "source": "ffCustomCopy",   "sourceHandle": "1", "target": "ffExec1",        "targetHandle": null, "id": "e10a" },
    { "source": "ffCustomEncode", "sourceHandle": "1", "target": "ffExec1",        "targetHandle": null, "id": "e10b" },
    { "source": "ffExec1",        "sourceHandle": "1", "target": "checkDuration1", "targetHandle": null, "id": "e11" },
    { "source": "checkDuration1", "sourceHandle": "1", "target": "checkSize1",     "targetHandle": null, "id": "e12" },
    { "source": "checkDuration1", "sourceHandle": "2", "target": "failDuration",   "targetHandle": null, "id": "e13a" },
    { "source": "checkDuration1", "sourceHandle": "3", "target": "failDuration",   "targetHandle": null, "id": "e13b" },
    { "source": "checkSize1",     "sourceHandle": "1", "target": "healthCheck1",   "targetHandle": null, "id": "e14" },
    { "source": "checkSize1",     "sourceHandle": "2", "target": "failSize",       "targetHandle": null, "id": "e15a" },
    { "source": "checkSize1",     "sourceHandle": "3", "target": "failSize",       "targetHandle": null, "id": "e15b" },
    { "source": "healthCheck1",   "sourceHandle": "1", "target": "replace1",       "targetHandle": null, "id": "e16" },
    { "source": "replace1",       "sourceHandle": "1", "target": "keepDate1",      "targetHandle": null, "id": "e17" },
    { "source": "keepDate1",      "sourceHandle": "1", "target": "replaceHL1",     "targetHandle": null, "id": "e18" },
    { "source": "keepDate1",      "sourceHandle": "2", "target": "replaceHL1",     "targetHandle": null, "id": "e19" }
  ]
}
