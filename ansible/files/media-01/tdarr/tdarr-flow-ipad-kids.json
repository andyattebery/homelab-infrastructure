    {
      "name": "STD+HDR (<=1080p p4 cq32)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "leafStdHdr",
      "inputsDB": {
        "inputArguments": "-hwaccel cuda -hwaccel_output_format cuda",
        "outputArguments": "-vf scale_cuda=w=-2:h=min(1080\\,ih),tonemap_cuda=tonemap=bt2390:param=0.5:r=tv:format=p010le -c:v hevc_nvenc -preset p4 -rc vbr -b:v 0 -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -b_ref_mode middle -g 120 -cq 32 -tag:v hvc1"
      },
      "position": {
        "x": 1500,
        "y": -100
      }
    },
