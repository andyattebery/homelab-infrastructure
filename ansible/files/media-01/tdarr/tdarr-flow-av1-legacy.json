      "sourceRepo": "Community",
      "pluginName": "compareFileSizeRatio",
      "version": "2.0.0",
      "id": "checkSize1",
      "inputsDB": { "greaterThan": "10" },
      "position": { "x": 3600, "y": 0 }
    },
    {
