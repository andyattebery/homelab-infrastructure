    },
    {
      "name": "Replace Original File",
      "sourceRepo": "Community",
      "pluginName": "replaceOriginalFile",
      "version": "1.0.0",
      "id": "replace1",
      "inputsDB": {},
      "position": { "x": 4200, "y": 0 }
    },
    {
      "name": "Keep Original Date",
      "sourceRepo": "Local",
      "pluginName": "keepOriginalDate",
      "version": "1.0.0",
      "id": "keepDate1",
      "inputsDB": {},
      "position": { "x": 4350, "y": 0 }
    },
    {
      "name": "Replace Hardlinks",
      "sourceRepo": "Local",
      "pluginName": "replaceHardlinks",
      "version": "1.0.0",
      "id": "replaceHL1",
      "inputsDB": {},
      "position": { "x": 4650, "y": 0 }
    },
    {
      "name": "Fail (Bad Duration)",
      "sourceRepo": "Community",
      "pluginName": "failFlow",
      "version": "1.0.0",
      "id": "failDuration",
      "inputsDB": {},
      "position": { "x": 3600, "y": -300 }
    },
    {
      "name": "Fail (Bad Size)",
      "sourceRepo": "Community",
      "pluginName": "failFlow",
      "version": "1.0.0",
      "id": "failSize",
      "inputsDB": {},
      "position": { "x": 3900, "y": -300 }
    }
