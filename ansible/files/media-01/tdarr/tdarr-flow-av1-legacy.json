{
  "name": "AV1 NVENC — Legacy (mpeg4, <50fps)",
  "description": "MPEG4 (DivX/Xvid) to AV1 (NVENC p7/uhq/10-bit CQ 34) in MP4. fps <50 gate. Deinterlaces interlaced content with bwdif. Detects and replaces hardlinks. Three-stage integrity guard. Preserves original file dates.",
  "tags": "video,av1,nvenc,hardlink,legacy",
  "flowPlugins": [
    {
      "name": "Input File",
      "sourceRepo": "Community",
      "pluginName": "inputFile",
      "version": "1.0.0",
      "id": "input1",
      "inputsDB": {},
      "position": { "x": 0, "y": 0 }
    },
    {
      "name": "Check Video Codec",
      "sourceRepo": "Community",
      "pluginName": "checkVideoCodec",
      "version": "1.0.0",
      "id": "checkCodec1",
      "inputsDB": { "codec": "mpeg4" },
      "position": { "x": 300, "y": 0 }
    },
    {
      "name": "Check FPS",
      "sourceRepo": "Local",
      "pluginName": "checkVideoProperties",
      "version": "1.0.0",
      "id": "checkProps1",
      "inputsDB": { "maxFps": "50" },
      "position": { "x": 600, "y": 0 }
    },
    {
      "name": "Detect Hardlinks",
      "sourceRepo": "Local",
      "pluginName": "detectHardlinks",
      "version": "1.0.0",
      "id": "detectHL1",
      "inputsDB": {},
      "position": { "x": 900, "y": 0 }
    },
    {
      "name": "Begin Command",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandStart",
      "version": "1.0.0",
      "id": "ffStart1",
      "inputsDB": {},
      "position": { "x": 1200, "y": 0 }
    },
    {
      "name": "Set Container",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetContainer",
      "version": "1.0.0",
      "id": "ffContainer1",
      "inputsDB": { "container": "mp4", "forceConform": "true" },
      "position": { "x": 1500, "y": 0 }
    },
    {
      "name": "Set Video Encoder",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandSetVideoEncoder",
      "version": "1.0.0",
      "id": "ffEncoder1",
      "inputsDB": {
        "outputCodec": "av1",
        "hardwareEncoding": "true",
        "hardwareType": "nvenc",
        "hardwareDecoding": "true",
        "forceEncoding": "false",
        "ffmpegPresetEnabled": "false",
        "ffmpegQualityEnabled": "false"
      },
      "position": { "x": 1800, "y": 0 }
    },
    {
      "name": "Remove Subtitles",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandRemoveSubtitles",
      "version": "1.0.0",
      "id": "ffRemoveSubs",
      "inputsDB": {},
      "position": { "x": 1900, "y": 0 }
    },
    {
      "name": "Remove Data Streams",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandRemoveDataStreams",
      "version": "1.0.0",
      "id": "ffRemoveData",
      "inputsDB": {},
      "position": { "x": 2000, "y": 0 }
    },
    {
      "name": "Check Field Order",
      "sourceRepo": "Community",
      "pluginName": "checkStreamProperty",
      "version": "1.0.0",
      "id": "checkFieldOrder1",
      "inputsDB": {
        "propertyToCheck": "field_order",
        "valuesToMatch": "tt,bb,tb,bt",
        "condition": "includes",
        "streamType": "video"
      },
      "position": { "x": 2100, "y": 0 }
    },
    {
      "name": "Check Audio (interlaced)",
      "sourceRepo": "Community",
      "pluginName": "checkAudioCodec",
      "version": "1.0.0",
      "id": "checkAudioDeint",
      "inputsDB": { "codec": "aac" },
      "position": { "x": 2400, "y": -200 }
    },
    {
      "name": "Check Audio (progressive)",
      "sourceRepo": "Community",
      "pluginName": "checkAudioCodec",
      "version": "1.0.0",
      "id": "checkAudioProg",
      "inputsDB": { "codec": "aac" },
      "position": { "x": 2400, "y": 200 }
    },
    {
      "name": "Args (deint + copy AAC)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "ffCustomDeintCopy",
      "inputsDB": {
        "outputArguments": "-vf bwdif -preset p7 -tune uhq -rc vbr -b:v 0 -cq 34 -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -b_ref_mode middle -g 120 -pix_fmt p010le -c:a copy"
      },
      "position": { "x": 2700, "y": -300 }
    },
    {
      "name": "Args (deint + encode AAC)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "ffCustomDeintEncode",
      "inputsDB": {
        "outputArguments": "-vf bwdif -preset p7 -tune uhq -rc vbr -b:v 0 -cq 34 -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -b_ref_mode middle -g 120 -pix_fmt p010le -c:a aac"
      },
      "position": { "x": 2700, "y": -100 }
    },
    {
      "name": "Args (copy AAC)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "ffCustomCopy",
      "inputsDB": {
        "outputArguments": "-preset p7 -tune uhq -rc vbr -b:v 0 -cq 34 -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -b_ref_mode middle -g 120 -pix_fmt p010le -c:a copy"
      },
      "position": { "x": 2700, "y": 100 }
    },
    {
      "name": "Args (encode AAC)",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandCustomArguments",
      "version": "1.0.0",
      "id": "ffCustomEncode",
      "inputsDB": {
        "outputArguments": "-preset p7 -tune uhq -rc vbr -b:v 0 -cq 34 -rc-lookahead 32 -spatial-aq 1 -temporal-aq 1 -b_ref_mode middle -g 120 -pix_fmt p010le -c:a aac"
      },
      "position": { "x": 2700, "y": 300 }
    },
    {
      "name": "Execute",
      "sourceRepo": "Community",
      "pluginName": "ffmpegCommandExecute",
      "version": "1.0.0",
      "id": "ffExec1",
      "inputsDB": {},
      "position": { "x": 3000, "y": 0 }
    },
    {
      "name": "Check Duration Ratio",
      "sourceRepo": "Community",
      "pluginName": "compareFileDurationRatio",
      "version": "1.0.0",
      "id": "checkDuration1",
      "inputsDB": {},
      "position": { "x": 3300, "y": 0 }
    },
