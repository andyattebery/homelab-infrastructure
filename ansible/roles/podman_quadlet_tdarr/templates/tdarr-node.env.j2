{# Deployed at 0600 and referenced as EnvironmentFile= from the .container unit.

   Quadlet unit files are written world-readable at 0644, so anything secret has to live
   here instead of in an Environment= line. apiKey is empty while the server runs with auth
   off, and this file is where it goes the moment that changes. #}
apiKey={{ podman_quadlet_tdarr_api_key }}
