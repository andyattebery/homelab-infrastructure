[Unit]
Description=Tdarr library: {{ item.share }} on {{ podman_quadlet_tdarr_storage_host }}
Requires=network-online.target
After=network-online.target nss-lookup.target

[Mount]
What=//{{ podman_quadlet_tdarr_storage_host }}.{{ podman_quadlet_tdarr_storage_domain }}/{{ item.share }}
Where={{ item.src }}
Type=cifs
{# The password is deliberately NOT here: this file is 0644, and credentials= is read by the
   mount.cifs userspace helper from a 0600 file. That is also why the library is not mounted
   as a Quadlet .volume unit, which has no equivalent escape.

   No nofail or _netdev: both are fstab options, not mount.cifs options, and they are inert
   in a hand-written unit. The ordering they stand for is stated directly by After= above.

   serverino is not set either way here. mount.cifs(8): server inode numbers are "enabled by
   default", and a caller that needs them off passes noserverino through item.options. #}
Options=rw,uid={{ podman_quadlet_tdarr_puid }},gid={{ podman_quadlet_tdarr_pgid }},credentials={{ podman_quadlet_tdarr_smb_credentials_path }}{% if item.options | default('') | length > 0 %},{{ item.options }}{% endif %}

TimeoutSec=15

[Install]
WantedBy=multi-user.target
