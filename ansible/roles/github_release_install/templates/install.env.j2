# Written by Ansible: ansible/roles/github_release_install/templates/install.env.j2
# Do not edit -- the next playbook run overwrites this file.
#
# Read by github-release-update, which PARSES this file with shlex rather than sourcing it. Values
# are passed through Ansible's `quote` filter, i.e. shlex.quote, so a value is quoted only when it
# needs to be -- the mix of KEY=value and KEY='value' below is expected, and both forms read the
# same. Nothing here is ever handed to a shell, so a value cannot become a command.
#
# ASSET_PATTERN is resolved for this host's architecture ({{ ansible_facts['architecture'] }}); the
# role keys its pattern dict on that fact and only one entry can apply here.
NAME={{ github_release_install_name | quote }}
REPO={{ github_release_install_repo | quote }}
ASSET_PATTERN={{ github_release_install_asset_patterns[ansible_facts['architecture']] | quote }}
ARCHIVE_TYPE={{ github_release_install_archive_type | quote }}
BINARY_PATH={{ github_release_install_binary_path | quote }}

# ${VERSION} (tag with a leading 'v' stripped) and ${TAG} (raw tag_name) are substituted by the
# script at run time. They exist for archives whose directory is named after the release, where a
# literal captured today is wrong for every later release. The architecture is NOT a placeholder:
# this file is per-host, so the role has already resolved it above.
BINARY_IN_ARCHIVE={{ github_release_install_binary_in_archive_pattern | default('') | quote }}

# Version-command mode. Not used at all when USE_TAG_STAMP is true.
VERSION_COMMAND={{ github_release_install_version_command | quote }}
VERSION_REGEX={{ github_release_install_version_regex | quote }}

# Empty means the repo's 'latest' release.
RELEASE_TAG={{ github_release_install_release_tag | default('') | quote }}

# Tag-stamp mode: compares "<tag_name> <digest|id:N>" against the stamp file. The digest half is
# what makes an asset replaced in place under an unchanged tag visible.
USE_TAG_STAMP={{ github_release_install_use_tag_stamp | default(false) | string | lower | quote }}
TAG_STAMP_PATH={{ github_release_install_tag_stamp_path | quote }}

SYMLINK={{ github_release_install_symlink | default(false) | string | lower | quote }}
SYMLINK_PATH={{ github_release_install_symlink_path | quote }}

# Run through `sh -c`, and ONLY when the binary's bytes actually changed. Empty for every install
# whose consumer picks up a replaced binary on its own.
POST_UPDATE_COMMAND={{ github_release_install_post_update_command | default('') | quote }}
