.DS_Store
.ansible
.venv
ansible/*vars/**/vault.yaml
ansible/.claude/settings.local.json
.claude/settings.local.json

# sops decrypted temp files
nix/secrets/*.dec
nix/secrets/*.cleartext

# flashable disk images from nix/scripts/build-image.sh; they embed values rendered from
# nix/secrets/vars.nix
/nix/images/

# talos/generated/ holds the Talos cluster's secrets bundle, machine configs, talosconfig and
# kubeconfig; talos/images/ holds the images talos/scripts/flash-sd.sh downloads
/talos/generated/
/talos/images/

# agent working notes — hold unvaulted hostnames, IPs, and WAN details.
# Anchored with a leading slash: unanchored, `tasks/` matches a directory of that name at ANY
# depth, which silently ignores every new file under `ansible/roles/*/tasks/`. Existing roles look
# fine only because their task files are already tracked.
/status/
/handoffs/
/plans/
/tasks/

# compiled bytecode
__pycache__/
